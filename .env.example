# Required. Nothing starts without these.
CHATMAP_ENC_KEY=            # openssl rand -hex 16  (must be exactly 32 bytes)
POSTGRES_PASSWORD=          # openssl rand -hex 24
COOKIE_SECRET=              # openssl rand -hex 32, signs the chatmap-api session cookie
FLIGHTS_ID_KEY=             # openssl rand -hex 32, rotate between missions
FLIGHTS_CHAT_ID=nepal1      # linked device session id, must match the QR step

# Strongly recommended. Publishes only senders seen in the pilots' group, so a
# location shared in any other chat the linked phone can see never reaches the
# board. Find it with: docker compose exec flights uv run python \
#   /app/export_flights.py --list-chats
#FLIGHTS_CHAT_HASH=

# Optional, defaults shown.
#BOARD_PASSWORD=password       # board login is admin / this. SET IT IN PROD.
#FLIGHTS_INTERVAL=60           # seconds between exports
#FLIGHTS_PRE_WINDOW_MIN=15     # goes active this long before declared takeoff
#FLIGHTS_POST_WINDOW_MIN=5     # stays muted this long after landing
#FLIGHTS_STALE_AFTER_MIN=120   # airborne with no landing reported -> overdue
# minlon,minlat,maxlon,maxlat - flights outside are dropped. Default is the pilot AOI.
#FLIGHTS_BBOX=84.479370,27.474161,86.044922,28.623104
