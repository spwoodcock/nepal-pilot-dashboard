nepal-pilots.response.hotosm.org {
	root * /srv/flights

	basic_auth {
		admin {env.BOARD_PASSWORD_HASH}
	}

	# No 503 kill switch: a stale board is still worth reading, so the page
	# itself warns and keeps showing the last known positions.
	file_server
	header Cache-Control "no-cache"
	header X-Robots-Tag "noindex, nofollow"
}
